rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Dokumen admin hanya dapat dibaca oleh pemilik UID untuk verifikasi login.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Berita publik dapat dibaca semua pengunjung; semua operasi pengelolaan oleh admin aktif.
    match /news/{newsId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Konten statis harus bisa dibaca publik. Hanya admin aktif yang boleh menulis.
    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
